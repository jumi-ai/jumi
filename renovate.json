{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "group:allDigest"
  ],
  "addLabels": [
    "jumi",
    "ignore-conflicts"
  ],
  "customManagers": [
    {
      "description": "Non-Docker tool versions in .gitea/tool-versions.env (no digest handling).",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.gitea\\/tool-versions\\.env$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-releases|npm) depName=(?<depName>[^\\s]+)\\n[A-Z_]+=(?<currentValue>[^\\s]+)"
      ]
    },
    {
      "description": "Temurin JDK tag with Docker digest pinning in .gitea/tool-versions.env.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.gitea\\/tool-versions\\.env$/"
      ],
      "matchStrings": [
        "# renovate: datasource=docker depName=eclipse-temurin\\nTEMURIN_TAG=(?<currentValue>[^\\s@]+)(@(?<currentDigest>sha256:[0-9a-f]+))?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "eclipse-temurin",
      "autoReplaceStringTemplate": "# renovate: datasource=docker depName=eclipse-temurin\nTEMURIN_TAG={{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"
    },
    {
      "description": "Codex amd64 musl-package archive checksum: tag plus its verified sha256 moves with the release via github-release-attachments (hosted-supported digest updating, no post-upgrade commands). Values stay in tag form so getDigest requests releases/tags/rust-vX.Y.Z.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.gitea\\/tool-versions\\.env$/"
      ],
      "matchStrings": [
        "CODEX_AMD64_TAG=(?<currentValue>rust-v[^\\s]+)\\nCODEX_SHA256_AMD64=(?<currentDigest>[0-9a-f]{64})"
      ],
      "datasourceTemplate": "github-release-attachments",
      "depNameTemplate": "openai/codex",
      "versioningTemplate": "regex:^rust-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "autoReplaceStringTemplate": "CODEX_AMD64_TAG={{{newValue}}}\nCODEX_SHA256_AMD64={{{newDigest}}}"
    },
    {
      "description": "Codex arm64 musl-package archive checksum: tag plus its verified sha256 moves with the release via github-release-attachments (hosted-supported digest updating, no post-upgrade commands). Values stay in tag form so getDigest requests releases/tags/rust-vX.Y.Z.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.gitea\\/tool-versions\\.env$/"
      ],
      "matchStrings": [
        "CODEX_ARM64_TAG=(?<currentValue>rust-v[^\\s]+)\\nCODEX_SHA256_ARM64=(?<currentDigest>[0-9a-f]{64})"
      ],
      "datasourceTemplate": "github-release-attachments",
      "depNameTemplate": "openai/codex",
      "versioningTemplate": "regex:^rust-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "autoReplaceStringTemplate": "CODEX_ARM64_TAG={{{newValue}}}\nCODEX_SHA256_ARM64={{{newDigest}}}"
    },
    {
      "description": "constraints.bun must move in the same PR as BUN_VERSION, or that PR fails its own tripwire test.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^renovate\\.json$/"
      ],
      "matchStrings": [
        "\"constraints\":\\s*\\{[^}]*\"bun\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "oven-sh/bun"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Automerge patch and digest updates after required checks pass.",
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "automerge": true,
      "platformAutomerge": true,
      "ignoreTests": false
    },
    {
      "description": "Codex numeric version via github-releases: rust-v tags map to CODEX_VERSION, only stable numeric releases, grouped so version and both archive checksums move in one update.",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "openai/codex"
      ],
      "extractVersion": "^rust-v(?<version>.+)$",
      "allowedVersions": "/^[0-9]+\\.[0-9]+\\.[0-9]+$/",
      "groupName": "codex",
      "groupSlug": "codex"
    },
    {
      "description": "Codex tag-form archive checksums via github-release-attachments stay on rust-v tags so getDigest requests releases/tags/rust-vX.Y.Z; only stable tags, grouped with the numeric version update.",
      "matchDatasources": [
        "github-release-attachments"
      ],
      "matchPackageNames": [
        "openai/codex"
      ],
      "allowedVersions": "/^rust-v[0-9]+\\.[0-9]+\\.[0-9]+$/",
      "groupName": "codex",
      "groupSlug": "codex"
    },
    {
      "description": "oven-sh/bun tags releases as bun-v1.2.3, which github-releases cannot parse as semver.",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "oven-sh/bun"
      ],
      "extractVersion": "^bun-v(?<version>.+)$"
    },
    {
      "description": "Keep the worker JDK on Temurin 21.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "eclipse-temurin",
        "docker.io/library/eclipse-temurin"
      ],
      "allowedVersions": "/^21\\./"
    }
  ],
  "constraints": {
    "bun": "1.4.4"
  },
  "minimumReleaseAge": "3 days",
  "prCreation": "immediate",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "ignoreTests": true
}
